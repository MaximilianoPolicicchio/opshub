# Copy to .env.docker before running `docker compose up --build`.
#
#   cp .env.docker.example .env.docker
#
# These are throwaway local values. Nothing here is a real secret, and .env.docker
# is gitignored so the copy you edit never gets committed.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=opshub
POSTGRES_PORT=5432
# `db` is the compose service name, reachable from the api container.
DATABASE_URL=postgresql://postgres:postgres@db:5432/opshub?schema=public

# --- Auth ---
# Required: the API refuses to boot without these, and both must be >= 32 chars.
# Generate your own with: openssl rand -base64 48
JWT_ACCESS_SECRET=local-docker-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=local-docker-refresh-secret-change-me-9876543210
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Ports on the host ---
API_PORT=4000
WEB_PORT=3000

# --- Web ---
# Baked into the client bundle at build time, so it must be the URL the browser
# resolves, not the internal `api` service name.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
WEB_ORIGIN=http://localhost:3000

# --- Optional n8n integration ---
# Leave empty to run automations in SIMULATED mode.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Toggles ---
SCHEDULER_ENABLED=true
THROTTLE_ENABLED=true

# The compose stack serves plain HTTP on localhost while the web image runs in
# production mode, which would otherwise mark the session cookie Secure and stop
# it being sent back. Set to true only when serving over HTTPS.
COOKIE_SECURE=false

# Address the Next server uses to reach the API from inside the compose network.
# Distinct from NEXT_PUBLIC_API_URL, which is the browser's view.
API_INTERNAL_URL=http://api:4000/api/v1
