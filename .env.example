# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opshub?schema=public

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-a-random-32-plus-char-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-char-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- n8n integration (optional) ---
# Leave unset to run automations in SIMULATED mode.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_TIMEOUT_MS=5000

# --- Scheduler ---
SCHEDULER_ENABLED=true

# --- Server ---
WEB_ORIGIN=http://localhost:3000
API_PORT=4000

# --- Seed (dev only) ---
SEED_PASSWORD=DemoPassword123!

# --- Web app ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
