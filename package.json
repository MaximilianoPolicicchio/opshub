{
  "name": "opshub",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:api": "pnpm --filter @opshub/api dev",
    "dev:web": "pnpm --filter @opshub/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @opshub/api db:migrate",
    "db:seed": "pnpm --filter @opshub/api db:seed",
    "db:reset": "pnpm --filter @opshub/api db:reset"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
